<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Amritsar Law College - OmniTool Suite</title>
    <!-- Tailwind CSS for UI -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- PDF.js for rendering PDFs in browser -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
    <!-- pdf-lib for PDF manipulation -->
    <script src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
    <!-- SheetJS for Excel handling -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <!-- QR Code Generator -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <!-- Cropper.js for Professional Image Cropping -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css"/>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

    <style>
        .active-tab { background-color: #1e3a8a !important; color: white !important; font-weight: 600; }
        .drop-zone { border: 2px dashed #cbd5e1; }
        .drop-zone.dragover { border-color: #1e3a8a; background-color: #eff6ff; }
        .anmol-font-preview {
            font-family: 'Gurmukhi MN', 'Gurmukhi Sangam MN', 'Mukta', sans-serif;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-900 font-sans min-h-screen flex flex-col">

    <!-- Top Real-Time Date & Time Bar -->
    <div class="bg-slate-950 text-slate-200 text-xs py-1.5 px-4 border-b border-slate-800">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <span class="font-semibold tracking-wide text-slate-300">Official Digital Portal</span>
            <div id="liveDateTime" class="font-bold text-amber-400">Loading date and time...</div>
        </div>
    </div>

    <!-- Main Professional Header -->
    <header class="bg-gradient-to-r from-blue-950 via-indigo-950 to-slate-900 text-white shadow-xl border-b-4 border-amber-500">
        <div class="max-w-7xl mx-auto px-4 py-6">
            <div class="flex flex-col md:flex-row justify-between items-center gap-6">
                <div class="flex items-center gap-4 text-center md:text-left">
                    <div class="p-3 bg-white/10 rounded-xl backdrop-blur-sm border border-white/20">
                        <img src="https://media.licdn.com/dms/image/v2/C560BAQFHQUfkyDp2JA/company-logo_200_200/company-logo_200_200/0/1630641734650?e=2147483647&v=beta&t=wZD06s4NGLwLBKcNo9H2P6IybuLIXhZDYVJxiQwsYA0" class="w-12 h-12 md:w-14 md:h-14 object-contain" alt="Logo">   
                    </div>
                    <div>
                        <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight uppercase text-white drop-shadow-md">
                            Amritsar Law College
                        </h1>
                        <p class="text-amber-400 font-bold text-sm tracking-wider uppercase mt-0.5">
                            Admin Office
                        </p>
                        <p class="text-slate-300 text-xs md:text-sm mt-1 max-w-xl leading-relaxed">
                            Premier Institute for Legal Studies, Academic Excellence, and Digital Utility Management
                        </p>
                    </div>
                </div>
                <div class="w-full md:w-auto">
                    <input type="text" id="toolSearch" placeholder="Search utilities..." class="px-4 py-2.5 rounded-lg text-slate-900 bg-white shadow-inner focus:ring-2 focus:ring-amber-400 w-full md:w-72 text-sm border-0 font-medium">
                </div>
            </div>
        </div>
    </header>

    <!-- Scrolling Announcement Bar -->
    <div class="bg-amber-500 text-slate-950 font-bold text-xs md:text-sm py-2 overflow-hidden shadow-inner border-b border-amber-600">
        <marquee behavior="scroll" direction="left" scrollamount="6" class="whitespace-nowrap">
            Managed by Admin Office ALC &nbsp;&bull;&nbsp; Welcome to the Official Amritsar Law College Utility & Conversion Suite &nbsp;&bull;&nbsp; All processing is performed securely on your client browser.
        </marquee>
    </div>

    <!-- Main Content Workspace -->
    <div class="max-w-7xl mx-auto px-4 py-6 flex-grow flex flex-col md:flex-row gap-6 w-full">
        <!-- Sidebar Navigation -->
        <aside class="w-full md:w-64 bg-white rounded-xl shadow-md border border-slate-300 p-4 shrink-0 h-fit">
            <div class="space-y-6">
                <div>
                    <h2 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Academic Portal</h2>
                    <ul class="space-y-1 text-sm font-medium">
                        <li><button onclick="switchTab('attendance-eligibility', this)" class="tool-btn w-full text-left px-3 py-2 rounded-lg hover:bg-blue-50 hover:text-blue-900 transition text-slate-700">Attendance Eligibility</button></li>
                    </ul>
                </div>
                <div>
                    <h2 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">PDF Tools</h2>
                    <ul class="space-y-1 text-sm font-medium">
                        <li><button onclick="switchTab('pdf-converters', this)" class="tool-btn w-full text-left px-3 py-2 rounded-lg hover:bg-blue-50 hover:text-blue-900 transition text-slate-700">PDF Converters</button></li>
                        <li><button onclick="switchTab('edit-pdf', this)" class="tool-btn w-full text-left px-3 py-2 rounded-lg hover:bg-blue-50 hover:text-blue-900 transition text-slate-700">Edit & Manipulate</button></li>
                        <li><button onclick="switchTab('security-pdf', this)" class="tool-btn w-full text-left px-3 py-2 rounded-lg hover:bg-blue-50 hover:text-blue-900 transition text-slate-700">Security & Protection</button></li>
                    </ul>
                </div>
                <div>
                    <h2 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Media Tools</h2>
                    <ul class="space-y-1 text-sm font-medium">
                        <li><button onclick="switchTab('photo-crop-compress', this)" class="tool-btn w-full text-left px-3 py-2 rounded-lg hover:bg-blue-50 hover:text-blue-900 transition text-slate-700 active-tab">Photo Crop & Compress</button></li>
                        <li><button onclick="switchTab('img-tools', this)" class="tool-btn w-full text-left px-3 py-2 rounded-lg hover:bg-blue-50 hover:text-blue-900 transition text-slate-700">Image Tools & Compressor</button></li>
                        <li><button onclick="switchTab('media-converters', this)" class="tool-btn w-full text-left px-3 py-2 rounded-lg hover:bg-blue-50 hover:text-blue-900 transition text-slate-700">Audio & Video Tools</button></li>
                    </ul>
                </div>
                <div>
                    <h2 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Utilities</h2>
                    <ul class="space-y-1 text-sm font-medium">
                        <li><button onclick="switchTab('punjabi-translation', this)" class="tool-btn w-full text-left px-3 py-2 rounded-lg hover:bg-blue-50 hover:text-blue-900 transition text-slate-700">English to Punjabi (Anmol Lipi)</button></li>
                        <li><button onclick="switchTab('generators', this)" class="tool-btn w-full text-left px-3 py-2 rounded-lg hover:bg-blue-50 hover:text-blue-900 transition text-slate-700">Generators (QR, Pass)</button></li>
                        <li><button onclick="switchTab('calculators', this)" class="tool-btn w-full text-left px-3 py-2 rounded-lg hover:bg-blue-50 hover:text-blue-900 transition text-slate-700">Calculators (Age, BMI)</button></li>
                        <li><button onclick="switchTab('text-speech', this)" class="tool-btn w-full text-left px-3 py-2 rounded-lg hover:bg-blue-50 hover:text-blue-900 transition text-slate-700">Speech & Text Tools</button></li>
                        <li><button onclick="switchTab('dev-tools', this)" class="tool-btn w-full text-left px-3 py-2 rounded-lg hover:bg-blue-50 hover:text-blue-900 transition text-slate-700">Developer & Misc</button></li>
                    </ul>
                </div>
            </div>
        </aside>

        <!-- Tool Panels Workspace -->
        <main class="flex-grow bg-white rounded-xl shadow-md border border-slate-300 p-6 min-h-[600px]">

            <!-- STUDENT ATTENDANCE PERCENTAGE ELIGIBILITY -->
            <div id="attendance-eligibility" class="tab-content hidden">
                <h2 class="text-2xl font-bold mb-2 text-blue-950">Student Attendance Percentage & Professional Eligibility</h2>
                <p class="text-xs text-slate-600 mb-6">Calculate student attendance ratios against university guidelines and Bar Council of India (BCI) semester exam eligibility norms (minimum 75%).</p>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
                    <div class="lg:col-span-1 bg-slate-50 p-5 rounded-xl border border-slate-300 space-y-4">
                        <h3 class="font-bold text-slate-900 text-sm uppercase tracking-wider border-b border-slate-200 pb-2">Student Particulars</h3>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">Student Full Name</label>
                            <input type="text" id="attStudentName" placeholder="e.g. Amanpreet Singh" class="w-full p-2.5 border border-slate-300 rounded-lg text-sm bg-white font-medium">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">Enrollment / Roll No.</label>
                            <input type="text" id="attRollNo" placeholder="e.g. ALC/2026/045" class="w-full p-2.5 border border-slate-300 rounded-lg text-sm bg-white font-medium">
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">Total Classes Held</label>
                                <input type="number" id="attTotalClasses" min="1" placeholder="120" class="w-full p-2.5 border border-slate-300 rounded-lg text-sm bg-white font-medium">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">Classes Attended</label>
                                <input type="number" id="attPresentClasses" min="0" placeholder="95" class="w-full p-2.5 border border-slate-300 rounded-lg text-sm bg-white font-medium">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">Minimum Criteria Requirement</label>
                            <select id="attMinCriteria" class="w-full p-2.5 border border-slate-300 rounded-lg text-sm bg-white font-semibold text-slate-800">
                                <option value="75">75% (Standard University / BCI Norm)</option>
                                <option value="80">80% (Strict Compliance)</option>
                                <option value="70">70% (Relaxed Concession)</option>
                            </select>
                        </div>
                        <button onclick="calculateAttendanceRecord()" class="w-full bg-blue-900 hover:bg-blue-950 text-white font-bold py-2.5 rounded-lg shadow transition text-sm">
                            Compute Eligibility Status
                        </button>
                    </div>

                    <div class="lg:col-span-2 flex flex-col justify-between bg-gradient-to-br from-slate-900 to-blue-950 text-white p-6 rounded-xl border border-slate-800 shadow-xl">
                        <div>
                            <div class="flex justify-between items-center border-b border-slate-800 pb-4 mb-4">
                                <h3 class="font-bold text-amber-400 uppercase tracking-widest text-xs">Evaluation Report</h3>
                                <span id="attEvalTimestamp" class="text-xs text-slate-400">Ready for calculation</span>
                            </div>

                            <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
                                <div class="bg-white/10 p-4 rounded-lg backdrop-blur-sm border border-white/10">
                                    <span class="block text-xs text-slate-300 font-semibold uppercase">Attendance Rate</span>
                                    <span id="resAttendancePct" class="text-3xl font-extrabold text-white mt-1 block">-- %</span>
                                </div>
                                <div class="bg-white/10 p-4 rounded-lg backdrop-blur-sm border border-white/10">
                                    <span class="block text-xs text-slate-300 font-semibold uppercase">Professional Status</span>
                                    <span id="resEligibilityStatus" class="text-lg font-bold text-slate-400 mt-1 block">Pending</span>
                                </div>
                                <div class="col-span-2 md:col-span-1 bg-white/10 p-4 rounded-lg backdrop-blur-sm border border-white/10">
                                    <span class="block text-xs text-slate-300 font-semibold uppercase">Shortfall / Buffer</span>
                                    <span id="resShortfallBuffer" class="text-sm font-bold text-slate-200 mt-1 block">--</span>
                                </div>
                            </div>

                            <div id="resDetailedNote" class="text-xs text-slate-300 leading-relaxed bg-black/20 p-3 rounded-lg border border-white/5">
                                Please fill in the student records on the left panel to generate a professional percentage eligibility analysis.
                            </div>
                        </div>

                        <div class="mt-6 pt-4 border-t border-slate-800 flex flex-wrap gap-3 justify-end">
                            <button onclick="addAttendanceToTable()" class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold px-4 py-2 rounded-lg text-xs transition shadow">
                                Add to Master Ledger Sheet
                            </button>
                            <button onclick="exportAttendanceSheet()" class="bg-emerald-700 hover:bg-emerald-800 text-white font-bold px-4 py-2 rounded-lg text-xs transition shadow">
                                Export Ledger to Excel (.xlsx)
                            </button>
                        </div>
                    </div>
                </div>

                <div class="bg-slate-50 border border-slate-300 rounded-xl p-4 overflow-x-auto">
                    <h3 class="font-bold text-slate-900 text-sm mb-3 uppercase tracking-wider flex justify-between items-center">
                        <span>Master Attendance Ledger & Eligible Candidates Record</span>
                        <button onclick="clearAttendanceLedger()" class="text-xs text-red-700 hover:underline font-semibold">Clear Ledger</button>
                    </h3>
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="bg-slate-200 text-slate-700 uppercase">
                                <th class="p-2.5 border border-slate-300">Roll No.</th>
                                <th class="p-2.5 border border-slate-300">Student Name</th>
                                <th class="p-2.5 border border-slate-300 text-center">Total Held</th>
                                <th class="p-2.5 border border-slate-300 text-center">Attended</th>
                                <th class="p-2.5 border border-slate-300 text-center">Percentage</th>
                                <th class="p-2.5 border border-slate-300 text-center">Eligibility Status</th>
                            </tr>
                        </thead>
                        <tbody id="attendanceLedgerBody">
                            <tr>
                                <td colspan="6" class="p-4 text-center text-slate-500 font-medium">No student attendance records added to ledger yet.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            
            <!-- PDF CONVERTERS -->
            <div id="pdf-converters" class="tab-content hidden">
                <h2 class="text-2xl font-bold mb-4 text-blue-950">PDF Conversion Center</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
                    <div class="p-4 border border-slate-300 rounded-lg cursor-pointer hover:border-blue-700 bg-slate-50 hover:bg-blue-50 transition" onclick="setPdfConvertMode('pdf-to-jpg')">
                        <h3 class="font-bold text-lg text-slate-900">PDF to JPG</h3>
                        <p class="text-xs text-slate-600">Extract pages as standard images client-side.</p>
                    </div>
                    <div class="p-4 border border-slate-300 rounded-lg cursor-pointer hover:border-blue-700 bg-slate-50 hover:bg-blue-50 transition" onclick="setPdfConvertMode('jpg-to-pdf')">
                        <h3 class="font-bold text-lg text-slate-900">JPG / Images to PDF</h3>
                        <p class="text-xs text-slate-600">Compile image files into a PDF document.</p>
                    </div>
                    <div class="p-4 border border-slate-300 rounded-lg cursor-pointer hover:border-blue-700 bg-slate-50 hover:bg-blue-50 transition" onclick="setPdfConvertMode('excel-to-pdf')">
                        <h3 class="font-bold text-lg text-slate-900">Excel to PDF</h3>
                        <p class="text-xs text-slate-600">Render spreadsheets directly into PDF tables.</p>
                    </div>
                    <div class="p-4 border border-blue-300 rounded-lg bg-blue-50/70 shadow-sm">
                        <h3 class="font-bold text-blue-950">PDF to Word / Excel</h3>
                        <p class="text-xs text-slate-700 mt-1">Extract text blocks into structured editable formats (.docx, .xlsx, .txt).</p>
                        <div class="mt-3 flex gap-2">
                            <button onclick="setPdfConvertMode('pdf-to-word')" class="text-xs bg-blue-900 text-white px-2.5 py-1.5 rounded font-medium hover:bg-blue-950">To Word</button>
                            <button onclick="setPdfConvertMode('pdf-to-excel-data')" class="text-xs bg-emerald-700 text-white px-2.5 py-1.5 rounded font-medium hover:bg-emerald-800">To Excel</button>
                        </div>
                    </div>
                    <div class="p-4 border border-indigo-300 rounded-lg bg-indigo-50/70 shadow-sm">
                        <h3 class="font-bold text-indigo-950">Word / PPT to PDF</h3>
                        <p class="text-xs text-slate-700 mt-1">Convert text documents or presentations smoothly into formatted PDF layout.</p>
                        <button onclick="setPdfConvertMode('doc-to-pdf')" class="mt-3 text-xs bg-indigo-900 text-white px-3 py-1.5 rounded font-medium hover:bg-indigo-950">Convert to PDF</button>
                    </div>
                </div>

                <div class="p-6 border-2 border-dashed border-slate-300 rounded-xl bg-slate-50 text-center" id="pdfConverterZone">
                    <h3 class="font-semibold text-slate-800 mb-2" id="pdfConverterTitle">Select a Conversion Tool Above</h3>
                    <input type="file" id="pdfConvertInput" class="hidden" multiple>
                    <button onclick="document.getElementById('pdfConvertInput').click()" class="bg-blue-900 text-white px-5 py-2.5 rounded-lg shadow hover:bg-blue-950 transition font-medium text-sm">Choose File(s)</button>
                    <div id="pdfConvertOutput" class="mt-6 flex flex-col gap-3 items-center justify-center"></div>
                </div>
            </div>

            <!-- EDIT & MANIPULATE PDF -->
            <div id="edit-pdf" class="tab-content hidden">
                <h2 class="text-2xl font-bold mb-4 text-blue-950">Edit & Manipulate PDF</h2>
                <div class="flex gap-4 mb-4">
                    <input type="file" id="pdfEditInput" accept="application/pdf" class="block text-sm text-slate-700 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-900 hover:file:bg-blue-100">
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="md:col-span-1 space-y-4 bg-slate-50 p-4 rounded-lg border border-slate-300">
                        <h3 class="font-bold border-b border-slate-300 pb-2 text-slate-900">Page Operations</h3>
                        <button onclick="rotatePdfPages()" class="w-full bg-slate-900 text-white py-2 rounded hover:bg-slate-800 text-sm font-medium">Rotate All Pages (90°)</button>
                        <h3 class="font-bold border-b border-slate-300 pb-2 pt-2 text-slate-900">Add Content Overlay</h3>
                        <div>
                            <label class="block text-xs font-bold mb-1 text-slate-700">Add Custom Text</label>
                            <input type="text" id="pdfOverlayText" placeholder="Enter text..." class="w-full p-2 border border-slate-300 rounded text-sm mb-2 bg-white">
                            <button onclick="addTextToPdf()" class="w-full bg-blue-900 text-white py-1.5 rounded text-sm font-medium hover:bg-blue-950">Stamp Text onto Pages</button>
                        </div>
                        <div>
                            <label class="block text-xs font-bold mb-1 text-slate-700">Add Stamp Image</label>
                            <input type="file" id="pdfOverlayImg" accept="image/*" class="text-xs mb-2 text-slate-700">
                            <button onclick="addImageToPdf()" class="w-full bg-blue-900 text-white py-1.5 rounded text-sm font-medium hover:bg-blue-950">Stamp Image onto PDF</button>
                        </div>
                    </div>
                    <div class="md:col-span-2 border border-slate-300 rounded-lg p-4 bg-white min-h-[300px] flex flex-col items-center justify-center shadow-inner" id="pdfPreviewCanvas">
                        <span class="text-slate-500 text-sm font-medium">Upload a PDF to preview and apply manipulations</span>
                    </div>
                </div>
            </div>

            <!-- SECURITY & WATERMARK -->
            <div id="security-pdf" class="tab-content hidden">
                <h2 class="text-2xl font-bold mb-4 text-blue-950">Security, Protection & Page Formatting</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="p-4 border border-slate-300 rounded-lg bg-slate-50 space-y-3">
                        <h3 class="font-bold text-lg text-slate-900">Protect / Add Password</h3>
                        <input type="file" id="pdfProtectInput" accept="application/pdf" class="w-full text-sm text-slate-700">
                        <input type="password" id="pdfUserPassword" placeholder="Set User Password" class="w-full p-2 border border-slate-300 rounded text-sm bg-white">
                        <button onclick="protectPdf()" class="w-full bg-blue-900 text-white py-2 rounded text-sm font-medium hover:bg-blue-950">Encrypt & Protect PDF</button>
                    </div>
                    <div class="p-4 border border-slate-300 rounded-lg bg-slate-50 space-y-3">
                        <h3 class="font-bold text-lg text-slate-900">Unlock PDF (Remove Restrictions)</h3>
                        <input type="file" id="pdfUnlockInput" accept="application/pdf" class="w-full text-sm text-slate-700">
                        <input type="password" id="pdfUnlockPassword" placeholder="Enter Password" class="w-full p-2 border border-slate-300 rounded text-sm bg-white">
                        <button onclick="unlockPdf()" class="w-full bg-emerald-700 text-white py-2 rounded text-sm font-medium hover:bg-emerald-800">Decrypt PDF</button>
                    </div>
                    <div class="p-4 border border-slate-300 rounded-lg bg-slate-50 space-y-3">
                        <h3 class="font-bold text-lg text-slate-900">Add Page Numbers</h3>
                        <input type="file" id="pdfPageNumInput" accept="application/pdf" class="w-full text-sm text-slate-700">
                        <button onclick="addPageNumbers()" class="w-full bg-indigo-900 text-white py-2 rounded text-sm font-medium hover:bg-indigo-950">Add Page Numbers (Bottom-Right)</button>
                    </div>
                    <div class="p-4 border border-slate-300 rounded-lg bg-slate-50 space-y-3">
                        <h3 class="font-bold text-lg text-slate-900">Add Watermark</h3>
                        <input type="file" id="pdfWatermarkInput" accept="application/pdf" class="w-full text-sm text-slate-700">
                        <input type="text" id="watermarkText" placeholder="Confidential, Draft, etc." class="w-full p-2 border border-slate-300 rounded text-sm bg-white">
                        <button onclick="addWatermark()" class="w-full bg-indigo-900 text-white py-2 rounded text-sm font-medium hover:bg-indigo-950">Apply Diagonal Watermark</button>
                    </div>
                </div>
            </div>

            <!-- PHOTO CROP & COMPRESSOR (ENHANCED WITH PDF OUTPUT) -->
            <div id="photo-crop-compress" class="tab-content">
                <h2 class="text-2xl font-bold mb-4 text-blue-950">Professional Photo Crop & Compressor</h2>
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="lg:col-span-1 bg-slate-50 p-4 rounded-xl border border-slate-300 space-y-4">
                        <h3 class="font-bold text-slate-900 text-base border-b border-slate-300 pb-2">1. Select Photo</h3>
                        <input type="file" id="cropperInput" accept="image/*" class="w-full text-xs text-slate-700 file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-900 file:text-white hover:file:bg-blue-950">

                        <h3 class="font-bold text-slate-900 text-base border-b border-slate-300 pb-2 pt-2">2. Aspect Ratio & Controls</h3>
                        <div class="grid grid-cols-2 gap-2 text-xs font-semibold">
                            <button onclick="setCropperAspect(NaN)" class="p-2 border border-slate-300 rounded bg-white hover:bg-blue-50 text-slate-700">Free Form</button>
