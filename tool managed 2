    <script>
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';

        function updateDateTime() {
            const now = new Date();
            const options = { 
                weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',
                hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true 
            };
            document.getElementById('liveDateTime').innerText = now.toLocaleDateString('en-US', options);
            document.getElementById('footerYear').innerText = now.getFullYear();
        }
        setInterval(updateDateTime, 1000);
        updateDateTime();

        function switchTab(tabId, targetBtn) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            const activeTab = document.getElementById(tabId);
            if (activeTab) activeTab.classList.remove('hidden');
            
            document.querySelectorAll('.tool-btn').forEach(btn => btn.classList.remove('active-tab'));
            if (targetBtn) {
                targetBtn.classList.add('active-tab');
            } else {
                const defaultBtn = document.querySelector(`button[onclick*="'${tabId}'"]`);
                if (defaultBtn) defaultBtn.classList.add('active-tab');
            }
        }

        // ATTENDANCE ELIGIBILITY ENGINE
        let attendanceLedgerData = [];

        function calculateAttendanceRecord() {
            const name = document.getElementById('attStudentName').value.trim();
            const roll = document.getElementById('attRollNo').value.trim();
            const total = parseInt(document.getElementById('attTotalClasses').value);
            const present = parseInt(document.getElementById('attPresentClasses').value);
            const minReq = parseFloat(document.getElementById('attMinCriteria').value);

            if(!total || isNaN(present) || present < 0 || total <= 0 || present > total) {
                alert('Please enter valid class numbers (Total classes must be > 0 and Attended cannot exceed Total).');
                return null;
            }

            const pct = ((present / total) * 100).toFixed(2);
            const isEligible = pct >= minReq;
            
            document.getElementById('resAttendancePct').innerText = `${pct}%`;
            document.getElementById('attEvalTimestamp').innerText = `Evaluated: ${new Date().toLocaleTimeString()}`;
            
            const statusEl = document.getElementById('resEligibilityStatus');
            const noteEl = document.getElementById('resDetailedNote');
            const bufferEl = document.getElementById('resShortfallBuffer');

            if (isEligible) {
                statusEl.innerText = "ELIGIBLE (BCI Norms Met)";
                statusEl.className = "text-lg font-bold text-emerald-400 mt-1 block";
                bufferEl.innerText = `Surplus Buffer: +${(pct - minReq).toFixed(1)}%`;
                noteEl.innerHTML = `<span class="text-emerald-300 font-bold">✔ Success:</span> ${name || 'Student'} (${roll || 'N/A'}) satisfies the mandatory academic attendance regulation threshold of ${minReq}%. Clear to sit for professional semester examinations.`;
            } else {
                statusEl.innerText = "DEFICIENT (Ineligible)";
                statusEl.className = "text-lg font-bold text-rose-400 mt-1 block";
                const neededClasses = Math.ceil((minReq * total - 100 * present) / (100 - minReq));
                bufferEl.innerText = `Shortfall: ~${Math.max(0, neededClasses)} classes needed`;
                noteEl.innerHTML = `<span class="text-rose-300 font-bold">⚠ Notice:</span> ${name || 'Student'} fails to meet the required ${minReq}% threshold. Needs approximately <strong class="text-white">${Math.max(0, neededClasses)}</strong> consecutive classes attended to bridge the deficit.`;
            }

            return { name: name || 'Unnamed Student', roll: roll || 'N/A', total, present, pct, status: isEligible ? 'Eligible' : 'Deficient' };
        }

        function addAttendanceToTable() {
            const record = calculateAttendanceRecord();
            if(!record) return;

            attendanceLedgerData.push(record);
            renderAttendanceLedger();
            alert('Student record successfully registered into the Master Ledger!');
        }

        function renderAttendanceLedger() {
            const tbody = document.getElementById('attendanceLedgerBody');
            if(attendanceLedgerData.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-slate-500 font-medium">No student attendance records added to ledger yet.</td></tr>`;
                return;
            }
            tbody.innerHTML = '';
            attendanceLedgerData.forEach((item, index) => {
                const tr = document.createElement('tr');
                tr.className = index % 2 === 0 ? 'bg-white hover:bg-slate-100' : 'bg-slate-50 hover:bg-slate-100';
                tr.innerHTML = `
                    <td class="p-2.5 border border-slate-300 font-mono font-bold">${item.roll}</td>
                    <td class="p-2.5 border border-slate-300 font-semibold">${item.name}</td>
                    <td class="p-2.5 border border-slate-300 text-center">${item.total}</td>
                    <td class="p-2.5 border border-slate-300 text-center">${item.present}</td>
                    <td class="p-2.5 border border-slate-300 text-center font-bold text-blue-900">${item.pct}%</td>
                    <td class="p-2.5 border border-slate-300 text-center font-bold ${item.status === 'Eligible' ? 'text-emerald-700' : 'text-rose-700'}">${item.status}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function clearAttendanceLedger() {
