            document.getElementById('hexVal').innerText = hex;
            const r = parseInt(hex.slice(1, 3), 16);
            const g = parseInt(hex.slice(3, 5), 16);
            const b = parseInt(hex.slice(5, 7), 16);
            document.getElementById('rgbVal').innerText = `rgb(${r}, ${g}, ${b})`;
        }

        function convertUnits() {
            const val = parseFloat(document.getElementById('unitVal').value) || 0;
            const from = document.getElementById('unitFrom').value;
            let meters = val;
            if(from === 'km') meters = val * 1000;
            if(from === 'ft') meters = val * 0.3048;
            if(from === 'mi') meters = val * 1609.34;

            document.getElementById('unitResult').innerHTML = `
                ${meters.toFixed(2)} m | ${(meters/1000).toFixed(2)} km | ${(meters/0.3048).toFixed(2)} ft | ${(meters/1609.34).toFixed(2)} mi
            `;
        }

        function formatJSON() {
            const input = document.getElementById('jsonInput');
            try {
                const parsed = JSON.parse(input.value);
                input.value = JSON.stringify(parsed, null, 2);
            } catch(e) {
                alert('Invalid JSON String');
            }
        }

        function triggerPdfDownload(bytes, filename) {
            const blob = new Blob([bytes], { type: 'application/pdf' });
            downloadBlob(blob, filename);
        }

        function downloadBlob(blob, filename) {
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = filename;
            a.click();
        }

        document.getElementById('toolSearch').addEventListener('input', (e) => {
            const term = e.target.value.toLowerCase();
            document.querySelectorAll('.tool-btn').forEach(btn => {
                const txt = btn.innerText.toLowerCase();
                btn.parentElement.style.display = txt.includes(term) ? 'block' : 'none';
            });
        });

        // Initialize default tab to Photo Crop & Compress
        switchTab('photo-crop-compress');
        convertUnits();
    </script>
</body>
</html>
