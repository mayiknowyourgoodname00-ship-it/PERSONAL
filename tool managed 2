            if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
                return alert('Speech Recognition is not supported in this browser.');
            }
            const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
            if(!recognition) {
                recognition = new SpeechRec();
                recognition.continuous = true;
                recognition.interimResults = true;
                recognition.onresult = (e) => {
                    let text = '';
                    for(let i=e.resultIndex; i<e.results.length; i++) {
                        text += e.results[i][0].transcript;
                    }
                    document.getElementById('sttOutput').value = text;
                };
            }
            const btn = document.getElementById('sttBtn');
            if(btn.innerText.includes('Start')) {
                recognition.start();
                btn.innerText = 'Stop Recording';
                btn.className = btn.className.replace('bg-red-700', 'bg-slate-800');
            } else {
                recognition.stop();
                btn.innerText = 'Start Recording';
                btn.className = btn.className.replace('bg-slate-800', 'bg-red-700');
            }
        }

