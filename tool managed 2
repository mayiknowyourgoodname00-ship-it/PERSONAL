                    const pdfBytes = await pdfDoc.save();
                    renderDownloadLink(new Blob([pdfBytes], {type: 'application/pdf'}), 'document_converted.pdf', output);
                }
            } catch (err) {
                console.error(err);
                output.innerHTML = `<span class="text-red-700 text-xs font-bold">Conversion Error: Please verify the uploaded file format.</span>`;
            }
