<script>
let currentRole = 'admin';
const CREDS = {admin:'admin123', lib:'lib123', student:'student123'};

let books = [
  {isbn:'978-81-903099-1-5',title:'The Constitution of India',author:'P.M. Bakshi',cat:'Constitutional Law',copies:5,available:3},
  {isbn:'978-93-5009-076-0',title:'Indian Penal Code',author:'K.D. Gaur',cat:'Criminal Law',copies:4,available:2},
  {isbn:'978-93-5141-330-0',title:'Code of Criminal Procedure',author:'R.V. Kelkar',cat:'Criminal Law',copies:3,available:3},
  {isbn:'978-81-7534-481-7',title:'Law of Contracts',author:'Avtar Singh',cat:'Contract Law',copies:6,available:4},
  {isbn:'978-93-5009-047-0',title:'Constitutional Law of India',author:'H.M. Seervai',cat:'Constitutional Law',copies:2,available:0},
  {isbn:'978-81-7534-221-9',title:'Jurisprudence & Legal Theory',author:'V.D. Mahajan',cat:'Legal Theory',copies:4,available:4},
  {isbn:'978-93-5268-501-2',title:'Law of Evidence',author:'Batuk Lal',cat:'Evidence Law',copies:5,available:3},
  {isbn:'978-81-7534-321-6',title:'Civil Procedure Code',author:'C.K. Takwani',cat:'Civil Law',copies:4,available:2},
];

let members = [
  {id:'ALC2024001',name:'Harpreet Singh',course:'LLB 2nd Year',year:2,issued:3,status:'Active'},
  {id:'ALC2024002',name:'Manpreet Kaur',course:'LLB 1st Year',year:1,issued:1,status:'Active'},
  {id:'ALC2024003',name:'Gurpreet Singh',course:'LLM',year:1,issued:2,status:'Active'},
  {id:'ALC2024004',name:'Simran Batra',course:'LLB 3rd Year',year:3,issued:1,status:'Active'},
  {id:'ALC2024005',name:'Rajveer Bains',course:'LLB 2nd Year',year:2,issued:0,status:'Active'},
  {id:'FAC001',name:'Prof. Gurinder Pal Singh',course:'Faculty',year:0,issued:2,status:'Active'},
];

let issued = [
  {member:'Harpreet Singh',book:'Constitution of India',date:'2025-04-15',due:'2025-04-29',status:'overdue'},
  {member:'Gurpreet Singh',book:'Criminal Procedure',date:'2025-04-20',due:'2025-05-04',status:'overdue'},
  {member:'Simran Batra',book:'Contract Law',date:'2025-04-28',due:'2025-05-12',status:'active'},
  {member:'Manpreet Kaur',book:'Indian Penal Code',date:'2025-04-18',due:'2025-05-02',status:'overdue'},
  {member:'Prof. Gurinder Pal',book:'Constitutional Law',date:'2025-05-01',due:'2025-05-22',status:'active'},
];

let notices = [
  {title:'Library Closed on 26 Jan (Republic Day)',body:'The library will remain closed on 26th January 2026 on account of Republic Day. Normal services resume on 27th January.',date:'2025-01-20'},
  {title:'New Law Journals Arrived',body:'New issues of Supreme Court Cases (SCC), All India Reporter (AIR), and Criminal Law Journal are now available at the periodicals section.',date:'2025-05-10'},
  {title:'Fine Waiver for LLM Students',body:'All pending fines up to ₹200 for LLM students are waived for the examination period. Please visit the library counter with your ID card.',date:'2025-05-14'},
];

function setRole(r,btn){
  currentRole=r;
  document.querySelectorAll('.role-tab').forEach(t=>t.classList.remove('active'));
  btn.classList.add('active');
}

function doLogin(){
  const uid=document.getElementById('uid').value.trim();
  const pwd=document.getElementById('pwd').value.trim();
  const err=document.getElementById('errMsg');
  if(CREDS[uid]===pwd){
    err.style.display='none';
    document.getElementById('loginScreen').classList.remove('active');
    document.getElementById('appScreen').classList.add('active');
    document.getElementById('userLabel').textContent=uid==='admin'?'Administrator':uid==='lib'?'Librarian':'Student';
    initApp();
  } else {
    err.style.display='block';
  }
}

function logout(){
  document.getElementById('appScreen').classList.remove('active');
  document.getElementById('loginScreen').classList.add('active');
  document.getElementById('uid').value='';
  document.getElementById('pwd').value='';
}

function showPage(id,el){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
  document.getElementById('page-'+id).classList.add('active');
  el.classList.add('active');
}

function initApp(){
  renderBooks(); renderMembers(); renderIssued();
  renderDashboard(); renderReports(); renderNotices();
  const today=new Date().toISOString().split('T')[0];
  document.getElementById('issueDate').value=today;
  const due=new Date(); due.setDate(due.getDate()+14);
  document.getElementById('dueDate').value=due.toISOString().split('T')[0];
}

function renderDashboard(){
  const txns=[
    {m:'Harpreet Singh',b:'Constitution of India',type:'Issue',d:'15 May'},
    {m:'Gurpreet Singh',b:'Criminal Procedure',type:'Return',d:'14 May'},
    {m:'Simran Batra',b:'Contract Law',type:'Issue',d:'13 May'},
    {m:'Prof. Gurinder Pal',b:'Constitutional Law',type:'Issue',d:'12 May'},
    {m:'Manpreet Kaur',b:'Indian Penal Code',type:'Return',d:'11 May'},
  ];
  document.getElementById('dashTxns').innerHTML=txns.map(t=>`<tr><td>${t.m}</td><td>${t.b}</td><td><span class="badge ${t.type==='Issue'?'badge-issued':'badge-available'}">${t.type}</span></td><td>${t.d}</td><td><span class="badge ${t.type==='Issue'?'badge-issued':'badge-available'}">${t.type==='Issue'?'Active':'Returned'}</span></td></tr>`).join('');
  const arr=[
    {t:'Administrative Law',a:'I.P. Massey',d:'10 May 2025'},
    {t:'Family Law',a:'Paras Diwan',d:'08 May 2025'},
    {t:'International Law',a:'S.K. Kapoor',d:'03 May 2025'},
  ];
  document.getElementById('newArrivals').innerHTML=arr.map(b=>`<tr><td>${b.t}</td><td>${b.a}</td><td style="color:var(--muted)">${b.d}</td></tr>`).join('');
}

function renderBooks(){
  const q=(document.getElementById('bookSearch')||{value:''}).value.toLowerCase();
  const filtered=books.filter(b=>b.title.toLowerCase().includes(q)||b.author.toLowerCase().includes(q)||b.isbn.includes(q));
  document.getElementById('booksTable').innerHTML=filtered.map(b=>`<tr>
    <td style="font-size:11px;color:var(--muted)">${b.isbn}</td>
    <td style="font-weight:500">${b.title}</td>
    <td>${b.author}</td>
    <td><span class="badge badge-reserved">${b.cat}</span></td>
    <td>${b.copies}</td>
    <td><span class="badge ${b.available>0?'badge-available':'badge-overdue'}">${b.available>0?b.available+' Available':'Unavailable'}</span></td>
  </tr>`).join('');
}

function filterBooks(){renderBooks();}

function renderMembers(){
  const q=(document.getElementById('memberSearch')||{value:''}).value.toLowerCase();
  const filtered=members.filter(m=>m.name.toLowerCase().includes(q)||m.id.toLowerCase().includes(q));
  document.getElementById('membersTable').innerHTML=filtered.map(m=>`<tr>
    <td style="font-size:11px;color:var(--muted)">${m.id}</td>
    <td style="font-weight:500">${m.name}</td>
    <td>${m.course}</td>
    <td>${m.year===0?'—':m.year}</td>
    <td>${m.issued}</td>
    <td><span class="badge badge-available">${m.status}</span></td>
  </tr>`).join('');
}

function filterMembers(){renderMembers();}

function renderIssued(){
  document.getElementById('issuedTable').innerHTML=issued.map(i=>`<tr>
    <td>${i.member}</td>
    <td>${i.book}</td>
    <td>${i.date}</td>
    <td>${i.due}</td>
    <td><span class="badge ${i.status==='overdue'?'badge-overdue':'badge-issued'}">${i.status==='overdue'?'Overdue':'Active'}</span></td>
  </tr>`).join('');
}

function renderReports(){
  const cats=[{l:'Constitutional Law',v:38},{l:'Criminal Law',v:34},{l:'Contract Law',v:22},{l:'Civil Law',v:18},{l:'Evidence Law',v:12}];
  const max=cats[0].v;
  document.getElementById('catBars').innerHTML=cats.map(c=>`<div class="bar-row"><div class="bar-label">${c.l}</div><div class="bar-track"><div class="bar-fill" style="width:${Math.round(c.v/max*100)}%"></div></div><div class="bar-count">${c.v}</div></div>`).join('');
  const topB=[{l:'Constitution of India',v:18},{l:'Indian Penal Code',v:15},{l:'Contract Law',v:12},{l:'CrPC',v:11}];
  document.getElementById('topBookBars').innerHTML=topB.map(b=>`<div class="bar-row"><div class="bar-label">${b.l}</div><div class="bar-track"><div class="bar-fill" style="width:${Math.round(b.v/topB[0].v*100)}%"></div></div><div class="bar-count">${b.v}</div></div>`).join('');
  const trend=[{l:'Jan',v:60},{l:'Feb',v:72},{l:'Mar',v:85},{l:'Apr',v:91},{l:'May',v:94}];
  document.getElementById('trendBars').innerHTML=trend.map(t=>`<div class="bar-row"><div class="bar-label" style="width:32px">${t.l}</div><div class="bar-track"><div class="bar-fill" style="width:${Math.round(t.v/94*100)}%;background:var(--navy)"></div></div><div class="bar-count">${t.v}</div></div>`).join('');
}

function renderNotices(){
  document.getElementById('noticesList').innerHTML=notices.map(n=>`
    <div style="background:white;border:1px solid var(--border);border-radius:8px;padding:1.25rem;margin-bottom:12px;border-left:4px solid var(--gold)">
      <div style="display:flex;justify-content:space-between;align-items:start">
        <div style="font-weight:500;font-size:14px;color:var(--navy)">${n.title}</div>
        <span style="font-size:11px;color:var(--muted)">${n.date}</span>
      </div>
      <p style="font-size:13px;color:var(--muted);margin-top:6px;line-height:1.6">${n.body}</p>
    </div>`).join('');
}

function openAddBook(){document.getElementById('addBookModal').classList.add('open')}
function openAddMember(){document.getElementById('addMemberModal').classList.add('open')}
function openNotice(){document.getElementById('noticeModal').classList.add('open')}
function closeModal(id){document.getElementById(id).classList.remove('open')}

function addBook(){
  const t=document.getElementById('nb_title').value.trim();
  if(!t){return}
  books.push({isbn:document.getElementById('nb_isbn').value||'N/A',title:t,author:document.getElementById('nb_author').value,cat:document.getElementById('nb_cat').value,copies:parseInt(document.getElementById('nb_copies').value)||1,available:parseInt(document.getElementById('nb_copies').value)||1});
  closeModal('addBookModal');renderBooks();showToast('Book added successfully');
}

function addMember(){
  const n=document.getElementById('nm_name').value.trim();
  if(!n){return}
  members.push({id:document.getElementById('nm_id').value,name:n,course:document.getElementById('nm_course').value,year:1,issued:0,status:'Active'});
  closeModal('addMemberModal');renderMembers();showToast('Member registered successfully');
}

function issueBook(){
  const m=document.getElementById('issueMemId').value.trim();
  const b=document.getElementById('issueBookId').value.trim();
  if(!m||!b){showToast('Please enter Member ID and Book');return}
  issued.push({member:m,book:b,date:document.getElementById('issueDate').value,due:document.getElementById('dueDate').value,status:'active'});
  renderIssued();showToast('Book issued successfully');
  document.getElementById('issueMemId').value='';
  document.getElementById('issueBookId').value='';
}

function returnBook(){showToast('Book returned and record updated');}

function calcFine(){
  const d1=new Date(document.getElementById('fDue').value);
  const d2=new Date(document.getElementById('fReturn').value);
  if(!d1||!d2||isNaN(d1)||isNaN(d2)){return}
  const days=Math.max(0,Math.floor((d2-d1)/(1000*60*60*24)));
  const fine=days*10;
  const el=document.getElementById('fineResult');
  el.textContent='₹ '+fine;
  el.className='fine-result '+(fine===0?'zero':'');
  document.getElementById('collectBtn').style.display=fine>0?'inline-block':'none';
}

function collectFine(){showToast('Fine of '+document.getElementById('fineResult').textContent+' collected');document.getElementById('fineResult').textContent='₹ 0';document.getElementById('fineResult').className='fine-result zero';document.getElementById('collectBtn').style.display='none';}

function postNotice(){
  const t=document.getElementById('nt_title').value.trim();
  const b=document.getElementById('nt_body').value.trim();
  if(!t||!b){return}
  const today=new Date().toISOString().split('T')[0];
  notices.unshift({title:t,body:b,date:today});
  closeModal('noticeModal');renderNotices();showToast('Notice posted successfully');
  document.getElementById('nt_title').value='';
  document.getElementById('nt_body').value='';
}

function showToast(msg){
  const t=document.getElementById('toast');
  t.textContent=msg;t.style.display='block';
  setTimeout(()=>{t.style.display='none'},2800);
}
</script>
